# Copy to .env (gitignored) and edit. docker-compose reads this automatically.

# Required: secret used to mint the very first actor + token.
# Generate with: openssl rand -hex 32
GOVERNOR_BOOTSTRAP_TOKEN=

# Optional
GOVERNOR_PORT=8080
GOVERNOR_VERSION=dev

# ---- Durability ----
# Tier 1 (recommended): off-host replication via Litestream.
#
# Option A: any S3-compatible bucket. Set the URL + creds, plus optional
# endpoint/region/path-style knobs for non-AWS providers.
#GOVERNOR_REPLICATION_URL=s3://your-bucket/governor
#LITESTREAM_ACCESS_KEY_ID=
#LITESTREAM_SECRET_ACCESS_KEY=
# Non-AWS providers (R2, B2, MinIO, Wasabi) usually need an endpoint:
#LITESTREAM_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#LITESTREAM_S3_REGION=us-west-002
#LITESTREAM_S3_FORCE_PATH_STYLE=true
#
# Option B: Google Cloud Storage with native auth (ADC). No key/secret
# needed — Litestream picks up credentials from the Cloud Run / GCE
# metadata server, or from `gcloud auth application-default login`
# locally. The container will refuse to start if the URL scheme is
# `gcs://` and ADC isn't available.
#GOVERNOR_REPLICATION_URL=gcs://your-bucket/governor
#
# Tier 2 (single-host, NOT durable against host failure): explicit opt-in.
#GOVERNOR_ALLOW_SINGLE_HOST=true
#
# Tier 3 (ephemeral, dev/CI only — every restart wipes data): explicit opt-in.
#GOVERNOR_ALLOW_EPHEMERAL=true

# Public read-only view (off by default).
GOVERNOR_PUBLIC_ENABLED=false
GOVERNOR_BRAND_NAME=Governor
GOVERNOR_BRAND_ACCENT=#1f6f5c
GOVERNOR_BRAND_LOGO_URL=
GOVERNOR_PUBLIC_TITLE=Attestation log
GOVERNOR_PUBLIC_TAGLINE=
GOVERNOR_PUBLIC_HIDE_ACTOR_NAMES=false
GOVERNOR_PUBLIC_HIDE_NOTES=false
