{
  "name": "@governor/worker",
  "version": "0.0.1",
  "private": true,
  "description": "Reference Governor server implementation on Cloudflare Workers + D1.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
