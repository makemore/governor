    "db:migrate:remote": "wrangler d1 migrations apply governor --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@governor/core": "file:../../core/ts",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.78.0"
  }
}
